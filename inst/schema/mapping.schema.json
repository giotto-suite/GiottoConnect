{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://giottosuite.com/schema/giotto-mapping-0.1.0.json",
  "title": "Giotto interoperability mapping",
  "description": "How a family of external objects maps onto the Giotto contract. Validated in R by GiottoConnect (supports type, required, enum, properties, items, additionalProperties: false and local $ref).",
  "type": "object",
  "required": [
    "mapping",
    "params",
    "source_nodes",
    "parts"
  ],
  "additionalProperties": false,
  "properties": {
    "mapping": {
      "$ref": "#/$defs/header"
    },
    "params": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/param"
      }
    },
    "source_nodes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/source_node"
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/part"
      }
    },
    "lossy": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/loss"
      }
    }
  },
  "$defs": {
    "header": {
      "type": "object",
      "required": [
        "id",
        "version",
        "status",
        "schema_version",
        "source",
        "target"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "patched-unreviewed",
            "failed",
            "draft"
          ]
        },
        "built": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "required": [
            "ecosystem",
            "class",
            "package",
            "applies_to"
          ],
          "additionalProperties": false,
          "properties": {
            "ecosystem": {
              "type": "string"
            },
            "class": {
              "type": "string"
            },
            "package": {
              "type": "string"
            },
            "built_with": {
              "type": "string"
            },
            "applies_to": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "package_version": {
                  "type": "string"
                },
                "predicates": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "path"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "type": "string"
                      },
                      "class": {
                        "type": "string"
                      },
                      "kind": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "target": {
          "type": "object",
          "required": [
            "contract",
            "version"
          ],
          "additionalProperties": false,
          "properties": {
            "contract": {
              "type": "string",
              "enum": [
                "giotto",
                "seurat"
              ]
            },
            "version": {
              "type": "string"
            }
          }
        },
        "fingerprint": {
          "type": "string"
        },
        "fixtures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "date",
              "change",
              "by"
            ],
            "additionalProperties": false,
            "properties": {
              "date": {
                "type": "string"
              },
              "from_version": {
                "type": "string"
              },
              "change": {
                "type": "string"
              },
              "by": {
                "type": "string",
                "enum": [
                  "params",
                  "rules",
                  "llm",
                  "human"
                ]
              }
            }
          }
        }
      }
    },
    "param": {
      "type": "object",
      "required": [
        "list",
        "rule"
      ],
      "additionalProperties": false,
      "properties": {
        "list": {
          "type": "string",
          "description": "a listing verb of the mapping's adapter (see adapterRegistry())"
        },
        "on": {
          "type": "string"
        },
        "rule": {
          "type": "string",
          "enum": [
            "first",
            "first_where",
            "name_is",
            "first_of_class",
            "value_of"
          ]
        },
        "where": {
          "$ref": "#/$defs/where"
        },
        "value": {
          "type": "string"
        },
        "class": {
          "type": "string"
        },
        "optional": {
          "type": "boolean"
        },
        "path": {
          "type": "string"
        },
        "as": {
          "type": "string",
          "enum": [
            "name",
            "path"
          ],
          "description": "bind the matched child's name (default) or its full path"
        }
      }
    },
    "source_node": {
      "type": "object",
      "required": [
        "path",
        "get"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "get": {
          "type": "object",
          "required": [
            "fn"
          ],
          "additionalProperties": false,
          "properties": {
            "fn": {
              "type": "string",
              "description": "an accessor of the mapping's adapter (see adapterRegistry())"
            },
            "on": {
              "type": "string"
            },
            "args": {
              "type": "object"
            }
          }
        }
      }
    },
    "op": {
      "type": "object",
      "required": [
        "op"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "select_cols",
            "exclude_cols",
            "rename",
            "transpose",
            "scale",
            "cast",
            "rownames_to_col",
            "set",
            "set_colnames",
            "replace"
          ]
        },
        "cols": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "map": {
          "type": "object"
        },
        "factor": {
          "type": "number"
        },
        "to": {
          "type": "string",
          "enum": [
            "integer",
            "double",
            "character",
            "sparse",
            "table"
          ]
        },
        "col": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "value": {},
        "pattern": {
          "type": "string",
          "description": "replace: fixed string to replace"
        },
        "replacement": {
          "type": "string"
        }
      }
    },
    "loss": {
      "type": "object",
      "required": [
        "kind",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "dropped",
            "estimated",
            "ambiguous",
            "recovered_from_parameters"
          ]
        },
        "path": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "target_keys": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spat_unit": {
          "type": "string"
        },
        "feat_type": {
          "type": [
            "string",
            "array"
          ],
          "items": {
            "type": "string"
          },
          "description": "feature_info: several feat_types with split_keyword (first takes the rest)"
        },
        "name": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "nn_type": {
          "type": "string"
        },
        "reduction": {
          "type": "string"
        },
        "assay": {
          "type": "string"
        },
        "layer": {
          "type": "string"
        },
        "fov": {
          "type": "string"
        },
        "boundary": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "graph": {
          "type": "string"
        },
        "split_keyword": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "alternative": {
      "type": "object",
      "required": [
        "id",
        "from"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "hook": {
          "type": "string"
        },
        "ops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/op"
          }
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/param"
          }
        },
        "lossy": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/loss"
          }
        },
        "to": {
          "$ref": "#/$defs/target_keys"
        }
      }
    },
    "part": {
      "type": "object",
      "required": [
        "id",
        "part",
        "from",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "part": {
          "type": "string",
          "enum": [
            "expression",
            "cell_metadata",
            "feat_metadata",
            "spatial_locs",
            "spatial_info",
            "dim_reduction",
            "nn_network",
            "feature_info"
          ]
        },
        "from": {
          "type": "string"
        },
        "hook": {
          "type": "string"
        },
        "ops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/op"
          }
        },
        "optional": {
          "type": "boolean"
        },
        "to": {
          "$ref": "#/$defs/target_keys"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/alternative"
          }
        },
        "lossy": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/loss"
          }
        },
        "for_each": {
          "$ref": "#/$defs/for_each"
        }
      }
    },
    "for_each": {
      "type": "object",
      "required": [
        "list",
        "as"
      ],
      "additionalProperties": false,
      "properties": {
        "list": {
          "type": "string",
          "description": "a listing verb of the mapping's adapter (see adapterRegistry())"
        },
        "on": {
          "type": "string"
        },
        "as": {
          "type": "string"
        },
        "where": {
          "$ref": "#/$defs/where"
        },
        "exclude": {
          "type": "string",
          "description": "regex of names to skip; may use params, e.g. \"^{assay}$\""
        },
        "strip": {
          "type": "string",
          "description": "regex removed from each name to give the placeholder {<as>_label}"
        },
        "rename": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "name -> {<as>_label} for listed names (before strip)"
        }
      }
    },
    "where": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": [
            "string",
            "array"
          ],
          "items": {
            "type": "string"
          }
        },
        "not_role": {
          "type": [
            "string",
            "array"
          ],
          "items": {
            "type": "string"
          }
        },
        "has_child_role": {
          "type": [
            "string",
            "array"
          ],
          "items": {
            "type": "string"
          }
        },
        "name_matches": {
          "type": "string"
        },
        "or_role": {
          "type": [
            "string",
            "array"
          ],
          "items": {
            "type": "string"
          }
        },
        "class": {
          "type": [
            "string",
            "array"
          ],
          "items": {
            "type": "string"
          }
        },
        "kind": {
          "type": [
            "string",
            "array"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
